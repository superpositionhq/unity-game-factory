{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unity-replay.verification/v1",
  "title": "ReplayScripts/Verification/report.json",
  "description": "The creation replay's verification: the project rebuilt headless from ReplayScripts/ and compared with the game at its final commit (files outside Assets/ byte-identical, assets equal by structure, scenes equal by objects). Written by the replay tool. A complete dataset needs this report; verdict.pass (true or false) is metadata.",
  "type": "object",
  "required": [
    "schema",
    "game",
    "final_commit",
    "time",
    "files",
    "assets",
    "scenes",
    "rows",
    "windows",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "unity-replay.verification/v1"
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "final_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "time": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "description": "byte comparison: assets (identical/differs counts), other (identical ...), lists of differing paths"
    },
    "assets": {
      "type": "object",
      "required": [
        "total"
      ],
      "description": "structural comparison of every asset: total and by_type counts"
    },
    "scenes": {
      "type": "object",
      "description": "per scene path: object counts matched / identical / differs / missing / extra"
    },
    "scenes_excluded": {
      "type": "object"
    },
    "rows": {
      "type": "object",
      "description": "workflow.jsonl rows against what each replayed run did"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "window",
          "commit"
        ],
        "properties": {
          "window": {
            "type": "integer",
            "minimum": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      },
      "description": "one per commit, in order"
    },
    "verdict": {
      "type": "object",
      "required": [
        "pass",
        "criteria"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "pass"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "pass": {
                "type": "boolean"
              },
              "result": {
                "type": "string"
              }
            }
          }
        },
        "exclusions": {
          "type": [
            "array",
            "object"
          ]
        },
        "informational": {
          "type": [
            "array",
            "object"
          ]
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "items": {
            "type": "array"
          }
        }
      }
    }
  }
}
