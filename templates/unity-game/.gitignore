# Unity's generated folders and build output only, anchored to the repo root (an unanchored "Build/" would also hide
# Assets/**/Build/ folders and anything named like them inside packs). Everything else is committed, every asset with
# its .meta; binaries go through LFS (.gitattributes).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
# Unity regenerates these on every open; they hold machine paths
/*.csproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/.vs/
/.idea/
/.vscode/
/.consulo/
# crash reports and the editor's own state
/sysinfo.txt
/crashlytics-build.properties
/Assets/AssetStoreTools*
__pycache__/
*.pyc
# generated export for review (recreate with git log); the dataset's git.log is built by the packager
/git.log
# the full dataset delivery and its packaging scratch: local only, too big for git
/Dataset.zip
/Dataset.pending.zip
/.dataset/
# the task checker's results: local only
/.task-checks/
