# Line endings: normalise text, leave binaries alone.
* text=auto

# Unity's own YAML (Force Text serialization): plain git text with LF, as Unity writes it, so diffs stay small.
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.anim text eol=lf
*.mask text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.mixer text eol=lf
*.playable text eol=lf
*.signal text eol=lf
*.lighting text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.vfx text eol=lf
*.terrainlayer text eol=lf
*.spriteatlas text eol=lf
*.spriteatlasv2 text eol=lf
# C# is checked out with LF everywhere: an editor step's sha256 in workflow.jsonl is of the file's bytes, and it must
# be the same on every machine whatever its autocrlf setting.
*.cs text eol=lf diff=csharp

# Every binary type goes through Git LFS (GitHub refuses files over 100 MB, and binary history bloats clones).
# Patterns are case-insensitive ([pP][nN][gG]) so FOO.PNG from a store pack is caught too.
# Add a type here BEFORE committing the first file of a new binary type (git lfs migrate rewrites history).

# Unity data that stays binary even under Force Text (baked lighting, terrain heightmaps, NavMesh), and asset bundles.
# These come after "*.asset text" above: the later line wins. Under Assets/ only: ProjectSettings/NavMeshAreas.asset
# is plain YAML.
Assets/**/LightingData.asset filter=lfs diff=lfs merge=lfs -text
Assets/**/*[lL]ighting[dD]ata*.asset filter=lfs diff=lfs merge=lfs -text
Assets/**/NavMesh*.asset filter=lfs diff=lfs merge=lfs -text
Assets/**/[tT]errain[dD]ata*.asset filter=lfs diff=lfs merge=lfs -text
